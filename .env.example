SITE_URL=https://buildbyalex.com

# Telegram bot — leads & reviews
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram ID — only this user receives notifications and can use the bot
ADMIN_CHAT_ID=552922805
# Shared secret echoed by Telegram in the webhook header (any random string)
TELEGRAM_WEBHOOK_SECRET=

# Where the file-based DB (leads/reviews) lives. Mount a persistent volume here on the server.
DATA_DIR=/app/data

# Upstash Redis — optional, rate-limits the forms. Forms still work without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
