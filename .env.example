SITE_URL=https://buildbyalex.com

# Search-engine ownership verification (optional). Paste the token from the
# HTML-tag method in Google Search Console / Yandex Webmaster — just the
# content value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Telegram bot — leads & reviews
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram ID — only this user receives notifications and can use the bot
ADMIN_CHAT_ID=552922805
# Shared secret echoed by Telegram in the webhook header (any random string)
TELEGRAM_WEBHOOK_SECRET=

# Where the file-based DB (leads/reviews) lives. Mount a persistent volume here on the server.
DATA_DIR=/app/data

# Upstash Redis — optional, rate-limits the forms. Forms still work without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GA4 measurement ID (G-XXXXXXXXXX). Empty = GA4 disabled, site works as before.
NEXT_PUBLIC_GA_ID=

# Public contact channels. Empty = the button is not rendered.
# Phone in international format without spaces, e.g. +48123456789
NEXT_PUBLIC_PHONE=
# WhatsApp number, digits only, e.g. 48123456789
NEXT_PUBLIC_WHATSAPP=

# Lead email copy (optional). Without RESEND_API_KEY leads go to Telegram only.
# Free tier at resend.com covers 3000 emails/month.
RESEND_API_KEY=
LEAD_EMAIL_TO=info@buildbyalex.com
LEAD_EMAIL_FROM=buildbyalex <leads@buildbyalex.com>
